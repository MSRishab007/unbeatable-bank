# Copy to terraform.tfvars and fill in. Billing IDs and emails are not secret,
# but keep terraform.tfvars out of Git anyway (it's personal per run).

project_id = "unbeatable-bank-XX" # XX = group number; must be globally unique

# Leave null for a personal project. Set it only if you are creating the project
# inside an organization you have permission to create projects in.
org_id = null

region = "us-central1"

# Start with only your own account. Add each teammate's ID once they have
# granted Billing Account User + Billing Account Costs Manager to the team.
billing_accounts = {
  a = "XXXXXX-XXXXXX-XXXXXX" # you
  # b = "XXXXXX-XXXXXX-XXXXXX"
  # c = "XXXXXX-XXXXXX-XXXXXX"
  # d = "XXXXXX-XXXXXX-XXXXXX" # keep for demo week
}

active_billing = "a"

# Teammates only (not yourself).
team_members = {
  # b = "teammate.b@gmail.com"
  # c = "teammate.c@gmail.com"
  # d = "teammate.d@gmail.com"
}

alert_emails = [
  "you@gmail.com",
  # "teammate.b@gmail.com",
]

github_repository = "MSRishab007/unbeatable-bank"
